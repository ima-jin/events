NEXT_PUBLIC_SERVICE_PREFIX=
NEXT_PUBLIC_DOMAIN=
IMAJIN_ENV=
IMAJIN_APP_DID=
NEXT_PUBLIC_IMAJIN_APP_ID=
IMAJIN_APP_ATTESTATION_ID=
IMAJIN_APP_CLAIM_CODE=
IMAJIN_APP_KEYSTORE=
SESSION_SECRET=
WEBHOOK_SECRET=
NOTIFY_WEBHOOK_SECRET=
CHECKIN_WEBHOOK_URL=
DYKIL_URL=
IMAJIN_EVENTS_PUBLISH_PATH=
PAY_SERVICE_API_KEY=
AUTH_URL=
PAY_SERVICE_URL=
CONNECTIONS_SERVICE_URL=
PROFILE_SERVICE_URL=
CHAT_SERVICE_URL=

# Events environment contract — blank values only; see docs/ENVIRONMENTS.md.
# Copy the target example to .env.local, chmod 600, then populate privately.
# PORT / NODE_ENV / NEXT_RUNTIME are framework/process-manager owned.
PORT=
NODE_ENV=
NEXT_RUNTIME=

# Required database: a role confined to the events schema. APP_DB_SCHEMA must be events.
DATABASE_URL=
APP_DB_SCHEMA=

# Required public kernel/auth URLs (all in the SAME environment).
IMAJIN_KERNEL_URL=
IMAJIN_AUTH_URL=
AUTH_SERVICE_URL=
NEXT_PUBLIC_IMAJIN_AUTH_URL=
NEXT_PUBLIC_AUTH_URL=
# Required app URLs include /events; NEXT_PUBLIC_BASE_PATH must be /events.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_EVENTS_URL=
NEXT_PUBLIC_BASE_PATH=
# SDK-derived URLs: dev uses dev- / imajin.ai; prod prefix stays unset.
NEXT_PUBLIC_SERVICE_PREFIX=
NEXT_PUBLIC_DOMAIN=
# dev uses dev; prod stays unset. NODE_ENV is production on BOTH deployments.
IMAJIN_ENV=

# Kernel-minted registration identity; registry id and service attestation are not keys.
IMAJIN_APP_DID=
NEXT_PUBLIC_IMAJIN_APP_ID=
IMAJIN_APP_ATTESTATION_ID=
# First claim happens only in the browser at /events/claim after boot.
# Persistent absolute bootstrap-keystore path, separate per environment, mode 0600.
IMAJIN_APP_KEYSTORE=
# FORBIDDEN: never set. Signing keys are fetched at boot, memory-only.
# IMAJIN_APP_PRIVATE_KEY=

# Payment webhook configuration is tracked separately in events#38.
WEBHOOK_SECRET=
# Optional integrations (requirements when enabling the corresponding feature).
NOTIFY_WEBHOOK_SECRET=
CHECKIN_WEBHOOK_URL=
DYKIL_URL=
IMAJIN_EVENTS_PUBLISH_PATH=
# Pay calls use this app's token; operator approval is required for
# pay:settle, pay:refund and pay:charge-pledges on apps:service-scopes.
# Public Stripe key for campaign card setup; baked into the browser build.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional server service overrides; otherwise derived from IMAJIN_KERNEL_URL.
AUTH_URL=
PAY_SERVICE_URL=
CONNECTIONS_SERVICE_URL=
PROFILE_SERVICE_URL=
CHAT_SERVICE_URL=
NOTIFY_SERVICE_URL=
REGISTRY_SERVICE_URL=
REGISTRY_URL=
# SDK fallback origins; normally unset because NEXT_PUBLIC_APP_URL is explicit.
APP_URL=
NEXT_PUBLIC_BASE_URL=

# Optional audience/admin/attribution config.
# Audience defaults to the registry slug events, NOT the shared kernel host.
IMAJIN_APP_AUD=
EVENTS_ADMIN_DIDS=
NODE_DID=
RELAY_IMAJIN_DID=
SESSION_COOKIE_SCOPE=
# Keep unset/false until #2529 soak sign-off; only exact true enables mutation.
ENABLE_TICKET_MIGRATION=

# stdout-only logging. Persistence switches must remain unset.
LOG_LEVEL=
ENABLE_REQUEST_LOG=
ENABLE_APP_LOG=
LOG_DB_TRANSPORT=
APP_LOG_LEVEL=
# SDK legacy internal-key paths NOT used by events; leave unset.
AUTH_INTERNAL_API_KEY=
PROFILE_INTERNAL_API_KEY=

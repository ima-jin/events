# DEV: copy to ~/dev/events/.env.local, chmod 600; fill privately.
# Use docs/ENVIRONMENTS.md for values. No secrets or values in this template.
# dev-events listens on 3006, kernel host dev-jin.imajin.ai, mount /events.
# Required build values: /events basePath; dev- service prefix; imajin.ai domain.
# Required runtime: IMAJIN_ENV dev, APP_DB_SCHEMA events, distinct dev identity.
DATABASE_URL=
APP_DB_SCHEMA=
IMAJIN_KERNEL_URL=
IMAJIN_AUTH_URL=
AUTH_SERVICE_URL=
NEXT_PUBLIC_IMAJIN_AUTH_URL=
NEXT_PUBLIC_AUTH_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_EVENTS_URL=
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SERVICE_PREFIX=
NEXT_PUBLIC_DOMAIN=
IMAJIN_ENV=
IMAJIN_APP_DID=
NEXT_PUBLIC_IMAJIN_APP_ID=
IMAJIN_APP_ATTESTATION_ID=
IMAJIN_APP_KEYSTORE=
# App self-secrets are vault-loaded at boot, never configured in env.
# The kernel signs callbacks; events verifies public keys and durable replay evidence.
CHECKIN_WEBHOOK_URL=
DYKIL_URL=
IMAJIN_EVENTS_PUBLISH_PATH=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
AUTH_URL=
PAY_SERVICE_URL=
CONNECTIONS_SERVICE_URL=
PROFILE_SERVICE_URL=
CHAT_SERVICE_URL=
NOTIFY_SERVICE_URL=
REGISTRY_SERVICE_URL=
REGISTRY_URL=
APP_URL=
NEXT_PUBLIC_BASE_URL=
IMAJIN_APP_AUD=
EVENTS_ADMIN_DIDS=
NODE_DID=
RELAY_IMAJIN_DID=
SESSION_COOKIE_SCOPE=
# Keep unset/false until dev cutover soak (#2529) is signed off.
ENABLE_TICKET_MIGRATION=
LOG_LEVEL=
ENABLE_REQUEST_LOG=
ENABLE_APP_LOG=
LOG_DB_TRANSPORT=
APP_LOG_LEVEL=
AUTH_INTERNAL_API_KEY=
PROFILE_INTERNAL_API_KEY=

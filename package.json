{
  "name": "imajin-events",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx scripts/start.ts --dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local --import tsx scripts/start.ts",
    "claim": "node --env-file-if-exists=.env.local --import tsx scripts/start.ts --claim-only",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ima-jin/auth": "0.8.18",
    "@ima-jin/auth-client": "0.8.27",
    "@ima-jin/config": "^0.8.16",
    "@ima-jin/fair": "0.8.22",
    "@ima-jin/logger": "^0.8.16",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "drizzle-orm": "^0.45.1",
    "next": "^15.5.24",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@ima-jin/vault-core": "0.8.24",
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "^15.5.24",
    "jsdom": "^30.1.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
